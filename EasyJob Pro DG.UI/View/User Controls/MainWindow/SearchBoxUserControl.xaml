<UserControl x:Class="EasyJob_ProDG.UI.View.User_Controls.SearchBoxUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EasyJob_ProDG.UI.View.User_Controls"
             xmlns:cc="clr-namespace:CustomControlLib;assembly=CustomControlLib"
             mc:Ignorable="d"
             Focusable="True"
             GotFocus="UserControl_GotFocus"
             >
    <UserControl.Resources>
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="IsCheckable"
                    Value="True" />

        </Style>
    </UserControl.Resources>
    
    <cc:SearchBox x:Name="SearchBox"
                  Text="{Binding TextToFilter}"
                  Background="{StaticResource Brush.Background.Main}"
                  VerticalAlignment="Top"
                  SettingsButtonFontFamily="{StaticResource IconsFont}"
                  SettingsButtonIcon="{StaticResource SettingsIcon}">
        <cc:SearchBox.SettingsMenuItemsSource>
            <x:Array Type="{x:Type FrameworkElement}">
                <MenuItem Header="POL" />
                <MenuItem Header="POD" />
            </x:Array>
        </cc:SearchBox.SettingsMenuItemsSource>
    </cc:SearchBox>
    
</UserControl>
