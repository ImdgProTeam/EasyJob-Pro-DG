<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Context menus for various cells in data grids -->
    <ContextMenu x:Key="ProperShippingNameContextMenu"
                 DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
        <ContextMenu.Resources>
            <Style TargetType="MenuItem">
                <Setter Property="IsCheckable"
                        Value="False" />
            </Style>
        </ContextMenu.Resources>
        
        <MenuItem Header="Set name from IMDG Code"
                  Command="{Binding RestoreProperShippingNameFromIMDGCodeCommand}"
                  CommandParameter="Selection"/>
        <MenuItem Header="Include technical name"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsTechnicalNameOfSelectedDgIncluded, Mode=OneWay}"
                  Command="{Binding IncludeTechnicalNameCommand}"
                  CommandParameter="Selection"/>
        <Separator />
        <MenuItem Header="{Binding ContextMenuViewModel.HeaderTitleLTDQTY}"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsToNameIncludedLimitedQuantity, Mode=OneWay}"
                  Command="{Binding AppendProperShippingNameCommand}"
                  CommandParameter="{Binding Header, RelativeSource={RelativeSource Self}}"/>
        <MenuItem Header="{Binding ContextMenuViewModel.HeaderTitleMAX1L}"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsToNameIncludedMax1l, Mode=OneWay}"
                  Command="{Binding AppendProperShippingNameCommand}"
                  CommandParameter="{Binding Header, RelativeSource={RelativeSource Self}}"/>
        <MenuItem Header="{Binding ContextMenuViewModel.HeaderTitleSTABILIZED}"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsToNameIncludedStabilized, Mode=OneWay}"
                  Command="{Binding AppendProperShippingNameCommand}"
                  CommandParameter="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <MenuItem Header="{Binding ContextMenuViewModel.HeaderTitleWASTE}"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsToNameIncludedWaste, Mode=OneWay}"
                  Command="{Binding AppendProperShippingNameCommand}"
                  CommandParameter="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <MenuItem Header="{Binding ContextMenuViewModel.HeaderTitleEMPTY_UNCLEANED}"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsToNameIncludedEmptyUncleaned, Mode=OneWay}"
                  Command="{Binding AppendProperShippingNameCommand}"
                  CommandParameter="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <MenuItem Header="{Binding ContextMenuViewModel.HeaderTitleCOOLANT}"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsToNameIncludedAsCoolant, Mode=OneWay}"
                  Command="{Binding AppendProperShippingNameCommand}"
                  CommandParameter="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <MenuItem Header="{Binding ContextMenuViewModel.HeaderTitleCONDITIONER}"
                  IsCheckable="True"
                  IsChecked="{Binding ContextMenuViewModel.IsToNameIncludedAsConditioner, Mode=OneWay}"
                  Command="{Binding AppendProperShippingNameCommand}"
                  CommandParameter="{Binding Header, RelativeSource={RelativeSource Self}}" />

    </ContextMenu>
</ResourceDictionary>