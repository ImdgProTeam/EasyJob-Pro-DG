<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Context menus for various cells in data grids -->
    <ContextMenu x:Key="ProperShippingNameContextMenu"
                 DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
        <ContextMenu.Resources>
            <Style TargetType="MenuItem">
                <Setter Property="IsCheckable"
                        Value="False" />
            </Style>
        </ContextMenu.Resources>
        
        <MenuItem Header="Set name from IMDG Code"
                  Command="{Binding RestoreProperShippingNameFromIMDGCodeCommand}"
                  CommandParameter="Selection"/>
        <MenuItem Header="Include technical name"
                  IsCheckable="True"
                  IsChecked="{Binding IsTechnicalNameOfSelectedDgIncluded, Mode=OneWay}"
                  Command="{Binding IncludeTechnicalNameCommand}"
                  CommandParameter="Selection"/>
        <Separator />
        <MenuItem Header="LIMITED QUANTITY" />
        <MenuItem Header="MAXIMUN 1 LITRE" />
        <MenuItem Header="STABILIZED" />
        <MenuItem Header="WASTE" />
        <MenuItem Header="EMPTY UNCLEANED" />
        <MenuItem Header="RESIDUE LAST CONTAINED" />
        <MenuItem Header="MOLTEN" />

    </ContextMenu>
</ResourceDictionary>