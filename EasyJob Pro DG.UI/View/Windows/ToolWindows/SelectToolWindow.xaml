<wind:ToolWindowTemplate x:Class="EasyJob_ProDG.UI.View.DialogWindows.SelectToolWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:wind="clr-namespace:EasyJob_ProDG.UI.View.Windows"
                         xmlns:local="clr-namespace:EasyJob_ProDG.UI.View.DialogWindows"
                         mc:Ignorable="d"
                         Height="600"
                         CaptureText="Selection tool"
                         ApplyCommand="{Binding ApplyCommand}"
                         WindowStartupLocation="CenterScreen"
                         >
        <local:SelectionControl Grid.Row="1" DataContext="{Binding SelectionControlViewModel}"/>

</wind:ToolWindowTemplate>
