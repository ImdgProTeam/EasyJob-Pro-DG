<wind:ToolWindowTemplate x:Class="EasyJob_ProDG.UI.View.DialogWindows.FilterToolWindow"
                         xmlns:wind="clr-namespace:EasyJob_ProDG.UI.View.Windows"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:base="clr-namespace:EasyJob_ProDG.UI.View.WindowBase"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:local="clr-namespace:EasyJob_ProDG.UI.View.DialogWindows"
                         xmlns:dtvm="clr-namespace:EasyJob_ProDG.UI.View.DialogWindows.ToolWindows"
                         CaptureText="Filter tool"
                         ApplyCommand="{Binding ApplyCommand}"
                         WindowCloseCommand="{Binding WindowClosedCommand}"
                         mc:Ignorable="d"
                         d:DataContext="{d:DesignInstance Type=local:ToolWindowsDesignTimeViewModel, IsDesignTimeCreatable=True}"
                         WindowStartupLocation="CenterScreen"
                         >
        <local:SelectionControl DataContext="{Binding SelectionControlViewModel}"/>
</wind:ToolWindowTemplate>

