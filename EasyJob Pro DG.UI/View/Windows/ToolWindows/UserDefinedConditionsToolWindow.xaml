<base:AnimatedToolWindow x:Class="EasyJob_ProDG.UI.View.DialogWindows.UserDefinedConditionsToolWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:base="clr-namespace:EasyJob_ProDG.UI.View.WindowBase"
                         xmlns:local="clr-namespace:EasyJob_ProDG.UI.View.DialogWindows"
                         mc:Ignorable="d"
                         Height="600"
                         Width="400"
                         Style="{StaticResource ToolWindowStyle}"
                         WindowStartupLocation="CenterScreen"
                         MouseLeftButtonDown="Window_MouseLeftButtonDown"
                         Activated="OnGotFocusHandler"
                         Deactivated="OnLostFocusHandler">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SummaryWindowButtonStyle}">
            </Style>
        </Grid.Resources>
        <!-- Capture -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Manage user-defined conditions"
                       Style="{StaticResource WindowTitleTextBlock}" />
            <Button Content="Clear"
                    Command="{Binding ClearCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource ButtonClearStyle}"
                    Padding="20 5"
                    Grid.Column="1" />
        </Grid>

        <!-- Main working part -->
        <DockPanel Grid.Row="1"
                   LastChildFill="True"
                   VerticalAlignment="Stretch">

            <!-- Description -->
            <TextBlock DockPanel.Dock="Top"
                       HorizontalAlignment="Stretch"
                       Background="WhiteSmoke"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="5"
                       Text="{Binding DescriptionText, 
                            FallbackValue='User-defined conditions provide notifications to user (same as conflicts) when conditions are met.'}">

            </TextBlock>


            <DataGrid DockPanel.Dock="Top"
                      ItemsSource="{Binding UserDefinedConditions}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch"
                      Margin="5">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="N"
                                        Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Condition"
                                        Width="*"
                                        Binding="{Binding ConditionDescription}" />
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+"
                                        ToolTip=""
                                        Command="{Binding EditConditionCommand}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="-"
                                        ToolTip="Remove condition"
                                        Command="{Binding RemoveConditionCommand}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Height="2"
                       Background="WhiteSmoke" />

            <Grid DockPanel.Dock="Bottom"
                  Margin="5"
                  VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <ComboBox Grid.ColumnSpan="1" />
                <TextBox Grid.Row="1"
                         Text="Enter value" />
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="Hint here" />

                <Button Grid.Column="1"
                        Grid.Row="0"
                        Content="New"
                        ToolTip="Add new condition" />
                <Button Grid.Column="1"
                        Grid.Row="1"
                        Content="Add"
                        ToolTip="Add condition" />
            </Grid>

        </DockPanel>

        <!-- Control buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Grid.Row="4"
                    Grid.ColumnSpan="2">
            <StackPanel.Resources>
            </StackPanel.Resources>

            <Button Content="Close"
                    Click="CloseWindow"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</base:AnimatedToolWindow>
