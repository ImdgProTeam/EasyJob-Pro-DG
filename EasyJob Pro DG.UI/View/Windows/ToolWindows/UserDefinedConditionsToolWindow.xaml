<wind:ToolWindowTemplate x:Class="EasyJob_ProDG.UI.View.DialogWindows.UserDefinedConditionsToolWindow"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:base="clr-namespace:EasyJob_ProDG.UI.View.WindowBase"
                         xmlns:wind="clr-namespace:EasyJob_ProDG.UI.View.Windows"
                         mc:Ignorable="d"
                         Height="400"
                         CaptureText="Manage user-defined conditions"
                         WindowStartupLocation="CenterScreen">

        <!-- Main working part -->
        <DockPanel LastChildFill="True"
                   VerticalAlignment="Stretch">

            <!-- Description -->
            <TextBlock DockPanel.Dock="Top"
                       HorizontalAlignment="Stretch"
                       Background="WhiteSmoke"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="5"
                       Text="{Binding DescriptionText, 
                            FallbackValue='User-defined conditions provide notifications to user (same as conflicts) when conditions are met.'}">

            </TextBlock>


            <DataGrid DockPanel.Dock="Top"
                      ItemsSource="{Binding UserDefinedConditions}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch"
                      Margin="5">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="N"
                                        Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Condition"
                                        Width="*"
                                        Binding="{Binding ConditionDescription}" />
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="+"
                                        ToolTip=""
                                        Command="{Binding EditConditionCommand}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="-"
                                        ToolTip="Remove condition"
                                        Command="{Binding RemoveConditionCommand}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Height="2"
                       Background="WhiteSmoke" />

            <Grid DockPanel.Dock="Bottom"
                  Margin="5"
                  VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <ComboBox Grid.ColumnSpan="1" />
                <TextBox Grid.Row="1"
                         Text="Enter value" />
                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="Hint here" />

                <Button Grid.Column="1"
                        Grid.Row="0"
                        Content="New"
                        ToolTip="Add new condition" />
                <Button Grid.Column="1"
                        Grid.Row="1"
                        Content="Add"
                        ToolTip="Add condition" />
            </Grid>

        </DockPanel>

</wind:ToolWindowTemplate>
