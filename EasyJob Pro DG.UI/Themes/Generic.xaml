<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wind="clr-namespace:EasyJob_ProDG.UI.View.Windows"
                    xmlns:base="clr-namespace:EasyJob_ProDG.UI.View.WindowBase">

    <!-- ****************************************** -->
    <!--   Tool Window Template -->
    <!-- ****************************************** -->
    <Style TargetType="wind:ToolWindowTemplate">
        <Setter Property="WindowState"
                Value="Normal" />
        <Setter Property="WindowStyle"
                Value="None" />
        <Setter Property="ShowInTaskbar"
                Value="False" />
        <Setter Property="AllowsTransparency"
                Value="True" />
        <Setter Property="ResizeMode"
                Value="CanResize" />
        <Setter Property="Background"
                Value="{DynamicResource Brush.ToolboxWindow.Background}" />
        <Setter Property="BorderThickness"
                Value="2" />
        <Setter Property="SizeToContent"
                Value="Height" />
        <Setter Property="Topmost"
                Value="True" />
        <Setter Property="FontFamily"
                Value="{DynamicResource BaseFont}" />
        <Setter Property="FontSize"
                Value="{DynamicResource StandardFontSize}" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CornerRadius="0"
                              GlassFrameThickness="0"
                              ResizeBorderThickness="5"
                              CaptionHeight="0"
                              UseAeroCaptionButtons="True" />
            </Setter.Value>
        </Setter>

        <Setter Property="Height"
                Value="600" />
        <Setter Property="Width"
                Value="400" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wind:ToolWindowTemplate">
                    <Border Background="{TemplateBinding Background}"
                            Padding="0"
                            x:Name="PART_DragBody">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>


                            <!--Capture-->
                            <TextBlock Text="{TemplateBinding CaptureText}"
                                       Style="{DynamicResource WindowTitleTextBlock}"
                                       HorizontalAlignment="Left">
                            </TextBlock>
                            <Button Content="Clear"
                                    Command="{Binding ClearCommand}"
                                    Style="{DynamicResource ButtonClearStyle}"
                                    HorizontalAlignment="Right"
                                    FontSize="15"
                                    Padding="20 5" />

                            <!--Main working part-->
                            <ContentPresenter Grid.Row="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="2" />

                            <!--Status text-->
                            <TextBlock Grid.Row="2"
                                       Margin="5 0"
                                       Text="{Binding StatusBarText, FallbackValue=''}" />

                            <!--Control buttons-->
                            <StackPanel  Grid.Row="2"
                                         Orientation="Horizontal"
                                         HorizontalAlignment="Right">

                                <Button Content="{Binding ApplyButtonText}"
                                        Command="{TemplateBinding ApplyCommand}"
                                        IsDefault="True"
                                        Style="{DynamicResource SummaryWindowButtonStyle}" />
                                <Button Content="Close"
                                        Command="{TemplateBinding OnCloseButtonPressedCommand}"
                                        IsCancel="True"
                                        Style="{DynamicResource SummaryWindowButtonStyle}" />

                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>